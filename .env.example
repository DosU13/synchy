# Copy this file, name the copy ".env", and paste your key after the = sign.
# The key comes from Google AI Studio (aistudio.google.com, "Get API key").
# Image generation is a paid feature there, so billing must be turned on for the key.
GEMINI_API_KEY=

# Optional: the model to try first. If it isn't available, the server tries others.
# GEMINI_MODEL=gemini-nano-banana-2.1

# Optional: the port of the booth page (http://localhost:8080).
# PORT=8080
